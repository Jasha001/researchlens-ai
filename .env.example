# SERVER ONLY. Never copy this file into the frontend or a public repository.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Select a model available in your AI Studio project's free tier.
GEMINI_MODEL=gemini-3.1-flash-lite
AI_MAX_OUTPUT_TOKENS=1600
AI_SUPPORT_REVIEW=true
MAX_AI_REQUESTS_PER_DAY=100
MAX_AI_REQUESTS_PER_SESSION_DAY=20
# Local default. Public mode requires the settings documented in DEPLOYMENT.md.
PUBLIC_MODE=false
APP_ORIGIN=http://localhost:8182
SESSION_SECRET=
SITE_ACCESS_CODE=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional development only: DEV_ORIGIN=http://localhost:5180

# Invited public beta defaults; see LAUNCH_BETA.md.
BETA_INVITE_ONLY=true
PRIVACY_CONTACT=

# Leave blank for local SQLite; set only on the hosting server for Neon.
DATABASE_URL=
FREE_HOST_MODE=false
